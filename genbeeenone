  <script>
    $(document).ready(function () {

      'use strict';

      /* ══════════════════════════════════════
         TOASTR CONFIG
      ══════════════════════════════════════ */
      toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: 'toast-bottom-right',
        timeOut: 2600,
        extendedTimeOut: 1000,
        showMethod: 'slideDown',
        hideMethod: 'fadeOut',
        showDuration: 200,
        hideDuration: 200
      };

      /* ══════════════════════════════════════
         PERFORMANCE FLAGS
      ══════════════════════════════════════ */
      const IS_FINE_POINTER = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const MAX_RENDER_ITEMS = 300;
      const CONCURRENCY = 4;
      const TEXTAREA_SYNC_EVERY = 15;

      /* ══════════════════════════════════════
         RIPPLE EFFECT
      ══════════════════════════════════════ */
      $(document).on('click', '.btn, .icon-btn, .nav-link', function (e) {
        const $b = $(this);
        if ($b.prop('disabled')) return;
        const rect = this.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height);
        const $r = $('<span class="ripple"></span>').css({
          width: size + 'px',
          height: size + 'px',
          left: (e.clientX - rect.left - size / 2) + 'px',
          top: (e.clientY - rect.top - size / 2) + 'px'
        });
        $b.append($r);
        setTimeout(() => $r.remove(), 620);
      });

      /* ══════════════════════════════════════
         CARD SPOTLIGHT FOLLOW (rAF throttled)
      ══════════════════════════════════════ */
      if (IS_FINE_POINTER) {
        let spotPending = false;
        let spotTarget = null;
        let spotX = 0, spotY = 0;

        $('.card').on('mousemove', function (e) {
          const r = this.getBoundingClientRect();
          spotTarget = this;
          spotX = e.clientX - r.left;
          spotY = e.clientY - r.top;
          if (!spotPending) {
            spotPending = true;
            requestAnimationFrame(() => {
              if (spotTarget) {
                spotTarget.style.setProperty('--mx', spotX + 'px');
                spotTarget.style.setProperty('--my', spotY + 'px');
              }
              spotPending = false;
            });
          }
        });
      }

      /* ══════════════════════════════════════
         SOUND ENGINE
      ══════════════════════════════════════ */
      let soundOn = true;
      let audioCtx = null;

      function beep(type) {
        if (!soundOn) return;
        try {
          audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          const o = audioCtx.createOscillator();
          const g = audioCtx.createGain();
          o.connect(g);
          g.connect(audioCtx.destination);
          o.type = type === 'live' ? 'triangle' : 'sine';
          o.frequency.value = type === 'live' ? 920 : 260;
          g.gain.setValueAtTime(0.0001, audioCtx.currentTime);
          g.gain.exponentialRampToValueAtTime(0.055, audioCtx.currentTime + 0.012);
          g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.16);
          o.start();
          o.stop(audioCtx.currentTime + 0.17);
        } catch (err) { /* silent */ }
      }

      $('#soundToggle').click(function () {
        soundOn = !soundOn;
        $(this).toggleClass('active', soundOn);
        $(this).find('i').attr('class', soundOn ? 'fas fa-volume-high' : 'fas fa-volume-xmark');
        toastr.info(soundOn ? 'Sound ON' : 'Sound OFF');
      });

      /* ══════════════════════════════════════
         ANIMATED NUMBER ROLLER
      ══════════════════════════════════════ */
      function rollNumber($el, to) {
        const from = parseInt($el.text(), 10) || 0;
        if (from === to) { $el.text(to); return; }
        const dur = 320;
        const t0 = performance.now();
        function step(now) {
          const p = Math.min(1, (now - t0) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          $el.text(Math.round(from + (to - from) * e));
          if (p < 1) requestAnimationFrame(step);
          else $el.text(to);
        }
        requestAnimationFrame(step);
      }

      /* ══════════════════════════════════════
         SESSION STATS
      ══════════════════════════════════════ */
      let sessionStart = 0;
      let tickTimer = null;

      function formatTime(secs) {
        const m = Math.floor(secs / 60);
        const s = Math.floor(secs % 60);
        return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
      }

      function startTicker() {
        sessionStart = performance.now();
        if (tickTimer) clearInterval(tickTimer);
        tickTimer = setInterval(updateStats, 500);
      }
      function stopTicker() {
        if (tickTimer) clearInterval(tickTimer);
        tickTimer = null;
      }
      function updateStats() {
        const done = counts.live + counts.die + counts.unknown;
        const secs = (performance.now() - sessionStart) / 1000;
        const spm = secs > 0.5 ? (done / secs) * 60 : 0;
        const rate = done > 0 ? (counts.live / done) * 100 : 0;
        $('#stat-speed').text(spm.toFixed(1) + '/m');
        $('#stat-time').text(formatTime(secs));
        $('#stat-rate').text(rate.toFixed(1) + '%');
      }

      /* ══════════════════════════════════════
         RESET
      ══════════════════════════════════════ */
      $('#resetDataBtn').click(function () {
        Swal.fire({
          title: 'Reset Everything?',
          text: 'Clear all data and inputs?',
          icon: 'warning',
          background: 'rgba(12, 18, 32, 0.90)',
          color: '#eef6ff',
          confirmButtonColor: '#38bdf8',
          cancelButtonColor: '#fb7185',
          showCancelButton: true,
          confirmButtonText: 'Yes, reset!'
        }).then(r => {
          if (r.isConfirmed) location.reload();
        });
      });

      /* ══════════════════════════════════════
         GENERATOR
      ══════════════════════════════════════ */
      $('#generateBtn').click(function () {
        const bin = $('#bin').val().trim();
        const qty = Math.min(5000, Math.max(1, parseInt($('#genqty').val(), 10) || 10));
        const setMonth = $('#month').val();
        const setYear = $('#year').val();
        const setCvv = $('#gencvv').val().trim();

        if (!bin) {
          toastr.error('Please enter a BIN pattern!');
          return;
        }

        const $btn = $(this);
        $btn.html('<i class="fas fa-cog fa-spin"></i> Generating...').prop('disabled', true);

        setTimeout(() => {
          const out = new Array(qty);

          for (let i = 0; i < qty; i++) {
            const cc = generateCard(bin);
            if (!cc) continue;
            const mo = (setMonth === 'Random')
              ? ('0' + (Math.floor(Math.random() * 12) + 1)).slice(-2)
              : setMonth;
            const yr = (setYear === 'Random')
              ? (Math.floor(Math.random() * 10) + 2026)
              : setYear;
            const cvv = setCvv ? setCvv : (Math.floor(Math.random() * 900) + 100);
            out[i] = cc + '|' + mo + '|' + yr + '|' + cvv;
          }

          const text = out.filter(Boolean).join('\n');
          $('#input-list').val(text);
          $('#total-count').text(out.filter(Boolean).length);
          toastr.success(qty + ' Cards Generated!');
          $btn.html('<i class="fas fa-bolt"></i> Generate').prop('disabled', false);
        }, 60);
      });

      $('#copyGenBtn').click(function () {
        const content = $('#input-list').val();
        if (!content) {
          toastr.warning('Nothing to copy!');
          return;
        }
        copyText(content, 'Copied to clipboard!');
      });

      /* Luhn-valid card generator */
      function generateCard(bin) {
        let cc = bin.replace(/[xX]/g, () => Math.floor(Math.random() * 10));
        cc = cc.replace(/\D/g, '');
        if (cc.length >= 16) cc = cc.substring(0, 15);
        while (cc.length < 15) cc += Math.floor(Math.random() * 10);

        let sum = 0, even = false;
        for (let i = cc.length - 1; i >= 0; i--) {
          let d = parseInt(cc[i], 10);
          if (even) {
            d *= 2;
            if (d > 9) d -= 9;
          }
          sum += d;
          even = !even;
        }
        const checkDigit = (10 - (sum % 10)) % 10;
        return cc + checkDigit;
      }

      /* ══════════════════════════════════════
         CHECKER
      ══════════════════════════════════════ */
      let isChecking = false;
      let checkQueue = [];
      let counts = { live: 0, die: 0, unknown: 0 };
      let activeWorkers = 0;
      let finished = true;
      let stoppedByUser = false;
      let runDone = 0;
      let runTotal = 0;
      let syncCounter = 0;

      const $inputList = $('#input-list');
      const $progressBar = $('#main-progress-bar');

      /* live count of pasted cards */
      $inputList.on('input', function () {
        const lines = $(this).val().split('\n').filter(l => l.trim().length > 5);
        $('#total-count').text(lines.length);
      });

      $('#btn-start').click(function () {
        if (isChecking) return;

        const list = $inputList.val().split('\n')
          .map(l => l.trim())
          .filter(l => l.length > 5);

        if (!list.length) {
          toastr.error('Please provide a card list!');
          return;
        }

        isChecking = true;
        finished = false;
        stoppedByUser = false;
        checkQueue = list.slice();
        runTotal = list.length;
        runDone = 0;
        syncCounter = 0;

        toggleControls(true);
        $('#status-display').show();
        $progressBar.css('width', '0%');
        $('body').addClass('checking');
        startTicker();
        toastr.info('Checking started...');
        startWorkers();
      });

      $('#btn-stop').click(function () {
        if (!isChecking) return;
        stoppedByUser = true;
        isChecking = false;
        checkQueue = [];
        toastr.warning('Stopped by user');
      });

      $('#btn-clean').click(function () {
        $('#lista_aprovadas, #lista_reprovadas, #lista_unknown').empty();
        counts = { live: 0, die: 0, unknown: 0 };
        updateBadges();
        toastr.info('Results cleared');
      });

      function toggleControls(active) {
        $('#btn-start').prop('disabled', active);
        $('#btn-stop').prop('disabled', !active);
        $inputList.prop('disabled', active);
      }

      function nowStamp() {
        const d = new Date();
        return String(d.getHours()).padStart(2, '0') + ':' +
               String(d.getMinutes()).padStart(2, '0') + ':' +
               String(d.getSeconds()).padStart(2, '0');
      }

      /* ── worker pool ── */
      function startWorkers() {
        const n = Math.min(CONCURRENCY, checkQueue.length);
        activeWorkers = n;
        for (let i = 0; i < n; i++) runWorker();
      }

      async function runWorker() {
        try {
          while (isChecking && checkQueue.length > 0) {
            const card = checkQueue.shift();
            if (!card) break;
            await handleCard(card);
          }
        } catch (err) {
          /* keep pool alive */
        } finally {
          activeWorkers--;
          if (activeWorkers <= 0) finishCheck();
        }
      }

      async function handleCard(card) {
        const gateway = $('#gate').val();
        const ts = nowStamp();

        $('#cur-card').text(card.substring(0, 6) + '••••••' + card.slice(-4));

        try {
          const res = await mockCheck(card, gateway);

          if (res.status === 'live') {
            counts.live++;
            prependResult('#lista_aprovadas', 'live-item', card, res.msg, ts);
            beep('live');
            toastr.success('LIVE: ' + card.substring(0, 8) + '***');
          } else if (res.status === 'die') {
            counts.die++;
            prependResult('#lista_reprovadas', 'die-item', card, res.msg, ts);
          } else {
            counts.unknown++;
            prependResult('#lista_unknown', 'unknown-item', card, res.msg, ts);
          }
        } catch (e) {
          counts.unknown++;
          prependResult('#lista_unknown', 'unknown-item', card, 'Error', ts);
        }

        runDone++;
        syncCounter++;

        /* throttled textarea sync */
        if (syncCounter >= TEXTAREA_SYNC_EVERY && checkQueue.length > 40) {
          syncCounter = 0;
          syncTextarea();
        }

        updateBadges();
        updateProgress();
      }

      function prependResult(sel, cls, card, msg, ts) {
        const $list = $(sel);
        $list.prepend(
          '<div class="result-item ' + cls + '">' + escapeHtml(card) +
          ' — ' + escapeHtml(msg) +
          '<i class="ts" data-ts="' + ts + '"></i></div>'
        );
        const total = $list.children().length;
        if (total > MAX_RENDER_ITEMS) {
          $list.children().slice(MAX_RENDER_ITEMS).remove();
        }
      }

      function syncTextarea() {
        if (isChecking) {
          $inputList.val(checkQueue.join('\n'));
        }
        $('#total-count').text(checkQueue.length);
      }

      function updateProgress() {
        const pct = runTotal > 0 ? (runDone / runTotal) * 100 : 0;
        $progressBar.css('width', Math.min(100, pct) + '%');
      }

      function finishCheck() {
        if (finished) return;
        finished = true;
        isChecking = false;

        toggleControls(false);
        $('#status-display').hide();
        $('body').removeClass('checking');
        stopTicker();
        updateStats();
        updateProgress();
        syncCounter = 0;
        syncTextarea();

        if (stoppedByUser) {
          toastr.warning('Checking stopped');
        } else if (runTotal > 0) {
          toastr.success('Checking Completed!');
        }
        stoppedByUser = false;
      }

      function updateBadges() {
        rollNumber($('#count-live'), counts.live);
        rollNumber($('#count-die'), counts.die);
        rollNumber($('#count-unknown'), counts.unknown);

        $('#badge-live').text(counts.live);
        $('#badge-die').text(counts.die);
        $('#badge-unknown').text(counts.unknown);
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      /* ══════════════════════════════════════
         MOCK CHECK ENGINE — FAST
      ══════════════════════════════════════ */
      function mockCheck(card, gate) {
        const profiles = {
          rnd_api:       { min: 25,  max: 90,  live: 0.20, die: 0.62 },
          b3_api:        { min: 60,  max: 160, live: 0.16, die: 0.66 },
          stripe_api:    { min: 40,  max: 120, live: 0.22, die: 0.60 },
          braintree_api: { min: 70,  max: 180, live: 0.14, die: 0.68 }
        };
        const p = profiles[gate] || profiles.rnd_api;

        const liveMsgs = [
          'Approved! CVV Matched',
          'Approved — 3DS Bypass',
          'Charged Successfully',
          'Approved — AVS Match'
        ];
        const dieMsgs = [
          'Declined: Insufficient Funds',
          'Declined: Invalid CVV',
          'Declined: Card Expired',
          'Declined: Do Not Honor',
          'Declined: Restricted Card'
        ];
        const unkMsgs = [
          'Timeout / Unknown Response',
          'Gateway Busy — Retry',
          '3DS Challenge Required',
          'No Response From Issuer'
        ];

        return new Promise(resolve => {
          const delay = Math.floor(Math.random() * (p.max - p.min)) + p.min;
          setTimeout(() => {
            const r = Math.random();
            if (r < p.live) {
              resolve({ status: 'live', msg: liveMsgs[(Math.random() * liveMsgs.length) | 0] });
            } else if (r < p.live + p.die) {
              resolve({ status: 'die', msg: dieMsgs[(Math.random() * dieMsgs.length) | 0] });
            } else {
              resolve({ status: 'unknown', msg: unkMsgs[(Math.random() * unkMsgs.length) | 0] });
            }
          }, delay);
        });
      }

      /* ══════════════════════════════════════
         CLIPBOARD HELPER (with fallback)
      ══════════════════════════════════════ */
      function copyText(text, okMsg) {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(
            () => toastr.success(okMsg || 'Copied!'),
            () => fallbackCopy(text, okMsg)
          );
        } else {
          fallbackCopy(text, okMsg);
        }
      }
      function fallbackCopy(text, okMsg) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-1000px';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          toastr.success(okMsg || 'Copied!');
        } catch (e) {
          toastr.error('Copy failed');
        }
        document.body.removeChild(ta);
      }

      /* ══════════════════════════════════════
         GLOBAL HELPERS
      ══════════════════════════════════════ */
      window.copyList = function (id) {
        let text = '';
        $('#' + id + ' .result-item').each(function () {
          text += $(this).text().trim() + '\n';
        });
        if (!text) {
          toastr.warning('List is empty');
          return;
        }
        copyText(text.trim(), 'List copied!');
      };

      window.clearList = function (id) {
        $('#' + id).empty();

        if (id === 'lista_aprovadas')      counts.live = 0;
        else if (id === 'lista_reprovadas') counts.die = 0;
        else if (id === 'lista_unknown')    counts.unknown = 0;

        updateBadges();
        toastr.info('List cleared');
      };

      /* ══════════════════════════════════════
         KEYBOARD SHORTCUTS
      ══════════════════════════════════════ */
      $(document).on('keydown', function (e) {
        if (e.ctrlKey && e.key === 'Enter') {
          e.preventDefault();
          if (!$('#btn-start').prop('disabled')) $('#btn-start').click();
        }
        if (e.key === 'Escape') {
          if (!$('#btn-stop').prop('disabled')) $('#btn-stop').click();
        }
      });

    });
  </script>
</body>
</html>
