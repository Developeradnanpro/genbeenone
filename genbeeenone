    /* ══════════════════════════════════════════
       SCANNING LINE — only runs while checking
    ══════════════════════════════════════════ */
    .scanning-line {
      pointer-events: none;
      position: absolute;
      left: 0; top: 0;
      width: 100%; height: 100%;
      border-radius: var(--radius-lg);
      background: linear-gradient(
        transparent 42%,
        rgba(125, 211, 252, 0.07) 50%,
        transparent 58%
      );
      background-size: 100% 220%;
      background-position: 0 -110%;
      z-index: 1;
      opacity: 0;
      mix-blend-mode: screen;
      transition: opacity var(--t-normal);
    }
    body.checking .scanning-line {
      opacity: 0.9;
      animation: scan 3.6s linear infinite;
    }
    @keyframes scan {
      0%   { background-position: 0 -110%; }
      100% { background-position: 0 110%; }
